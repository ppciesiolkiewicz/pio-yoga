# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables.

# --- Site ---------------------------------------------------------------
# Public URL of the site, used for canonical links, sitemap and hreflang.
NEXT_PUBLIC_SITE_URL=https://pio-yoga.vercel.app
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
# Calendly or Cal.com link for the free consultation
NEXT_PUBLIC_BOOKING_URL=

# --- Stripe (video program) ---------------------------------------------
# Leave empty until the program launches; the page shows "coming soon".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID of the video program product, e.g. price_123
STRIPE_PRICE_VIDEO_PROGRAM=
# Set to "true" to show the buy button
NEXT_PUBLIC_VIDEO_PROGRAM_ENABLED=false

# --- SEO / analytics (all optional) -------------------------------------
# Google Tag Manager container (GA4, Semrush-linked GA, ads pixels, etc.)
NEXT_PUBLIC_GTM_ID=
# Search engine ownership verification codes (content of the meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_SITE_VERIFICATION=
