{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "NEXT_PUBLIC_*",
        "STRIPE_*",
        "RESEND_API_KEY",
        "CONTACT_*",
        "VERCEL_*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:build": {
      "dependsOn": [
        "build"
      ],
      "env": [
        "NEXT_PUBLIC_SITE_URL"
      ]
    },
    "test:e2e": {
      "dependsOn": [
        "helpful-machines#build",
        "tangent#build"
      ],
      "cache": false
    },
    "test:lighthouse": {
      "dependsOn": [
        "helpful-machines#build",
        "tangent#build"
      ],
      "cache": false
    }
  }
}
